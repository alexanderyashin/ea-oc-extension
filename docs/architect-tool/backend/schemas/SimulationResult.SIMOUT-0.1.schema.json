{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://estra.local/schema/SIMOUT-0.1/SimulationResult.json",
  "title": "SimulationResult (SIMOUT-0.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["stop", "nodeStates", "ledger", "resultHash"],
  "properties": {
    "stop": { "type": "boolean" },
    "nodeStates": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "edgeStates": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ts", "code", "message"],
        "properties": {
          "ts": { "type": "string", "format": "date-time" },
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "resultHash": { "type": "string", "minLength": 16 }
  }
}
