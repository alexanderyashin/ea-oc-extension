{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://estra.local/schema/RAW-0.1/RawSnapshot.LeanIX.json",
  "title": "RawSnapshot LeanIX (RAW-0.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "factsheets", "relations", "errors", "rawHash"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSystem", "workspace", "capturedAt", "connectorVersion", "queries"],
      "properties": {
        "sourceSystem": { "type": "string", "const": "leanix" },
        "workspace": { "type": "string", "minLength": 1 },
        "capturedAt": { "type": "string", "format": "date-time" },
        "connectorVersion": { "type": "string", "minLength": 1 },
        "queries": { "type": "array", "items": { "type": "string" } }
      }
    },
    "factsheets": { "type": "array", "items": { "type": "object" } },
    "relations": { "type": "array", "items": { "type": "object" } },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "ref": { "type": "string" }
        }
      }
    },
    "rawHash": { "type": "string", "minLength": 16 }
  }
}
